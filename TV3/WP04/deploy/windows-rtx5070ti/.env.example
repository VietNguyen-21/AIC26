# Copy to .env and fill the three local DeepSolo/PARSeq paths supplied by the team.
WP04_DEVICE=cuda:0
WP04_GPU_MEMORY_FRACTION=0.88
WP04_HF_HOME=.cache/huggingface
WP04_MODEL_HOME=models

# Required for option 2. They are intentionally not downloaded or copied by this repo.
DEEPSOLO_HOME=C:\path\to\local\DeepSolo
DEEPSOLO_CHECKPOINT=C:\path\to\checkpoints\deepsolo_video.pth
PARSEQ_CHECKPOINT=C:\path\to\checkpoints\parseq_vietnamese.ckpt

# Each command receives {keyframe_path} or {audio_path} and must print JSON only.
WP04_DEEPSOLO_COMMAND=
WP04_CHUNKFORMER_COMMAND=
WP04_RFDETR_COMMAND=

# Optional only for private/gated Hugging Face assets. Never commit a real token.
HF_TOKEN=
