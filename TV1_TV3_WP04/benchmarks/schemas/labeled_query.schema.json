{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TV3LabeledQuery",
  "type": "object",
  "required": ["query_id", "query_text", "query_type", "relevant_video_ids"],
  "properties": {
    "query_id": {"type": "string", "minLength": 1},
    "query_text": {"type": "string", "minLength": 1},
    "query_type": {"enum": ["ocr", "asr", "object", "metadata", "mixed"]},
    "language": {"type": ["string", "null"]},
    "relevant_video_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "relevant_frame_intervals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["video_id", "start_ms", "end_ms"],
        "properties": {
          "video_id": {"type": "string"},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 0}
        }
      }
    },
    "expected_modality": {"type": ["string", "null"]},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
